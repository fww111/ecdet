<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1">
  <name>SPC3000</name>
  <description>航天姿轨控计算机 SoC（样例用寄存器模型）</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>GPIOA</name>
      <baseAddress>0x40020000</baseAddress>
      <registers>
        <register><name>IDR</name><addressOffset>0x10</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>ODR</name><addressOffset>0x14</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>BSRR</name><addressOffset>0x18</addressOffset><size>32</size><access>write-only</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>ADC</name>
      <baseAddress>0x40022000</baseAddress>
      <registers>
        <register><name>SR</name><addressOffset>0x00</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>CR</name><addressOffset>0x04</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>DR</name><addressOffset>0x08</addressOffset><size>32</size><access>read-only</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SPI1</name>
      <baseAddress>0x40023000</baseAddress>
      <registers>
        <register><name>CR1</name><addressOffset>0x00</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>SR</name><addressOffset>0x08</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>DR</name><addressOffset>0x0C</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>USART1</name>
      <baseAddress>0x40024000</baseAddress>
      <registers>
        <register><name>SR</name><addressOffset>0x00</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>DR</name><addressOffset>0x04</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>CR1</name><addressOffset>0x08</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIM2</name>
      <baseAddress>0x40025000</baseAddress>
      <registers>
        <register><name>CR1</name><addressOffset>0x00</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>SR</name><addressOffset>0x10</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>CNT</name><addressOffset>0x24</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>ARR</name><addressOffset>0x2C</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>IWDG</name>
      <baseAddress>0x40026000</baseAddress>
      <registers>
        <register><name>KR</name><addressOffset>0x00</addressOffset><size>32</size><access>write-only</access></register>
        <register><name>PR</name><addressOffset>0x04</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>SR</name><addressOffset>0x08</addressOffset><size>32</size><access>read-only</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>RTC</name>
      <baseAddress>0x40027000</baseAddress>
      <registers>
        <register><name>TR</name><addressOffset>0x00</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>DR</name><addressOffset>0x04</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>CR</name><addressOffset>0x08</addressOffset><size>32</size><access>read-write</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CAN1</name>
      <baseAddress>0x40028000</baseAddress>
      <registers>
        <register><name>MCR</name><addressOffset>0x00</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>MSR</name><addressOffset>0x04</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>TSR</name><addressOffset>0x08</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>RFR</name><addressOffset>0x0C</addressOffset><size>32</size><access>read-only</access></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PWR</name>
      <baseAddress>0x40029000</baseAddress>
      <registers>
        <register><name>CTRL</name><addressOffset>0x00</addressOffset><size>32</size><access>read-write</access></register>
        <register><name>STATUS</name><addressOffset>0x04</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>FLAGS</name><addressOffset>0x08</addressOffset><size>32</size><access>read-only</access></register>
        <register><name>LATCH</name><addressOffset>0x0C</addressOffset><size>32</size><access>write-only</access></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
